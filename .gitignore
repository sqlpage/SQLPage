.DS_STORE
/target
sqlpage.db
.idea/
*.mm_profdata
docs/presentation-pgconf.html
examples/inrap_badass/
sqlpage/https/*
x.sql
xbed.sql
**/sqlpage.bin
node_modules/
frontend/dist/
sqlpage/sqlpage.db
tests_uploads/
/test-results/
/playwright-report/

# Local environment overrides (never commit secrets here!)
# .env is tracked with safe defaults; use .env.local for secrets
.env.local
.env.*.local

# Apple signing certificates (sensitive - do not commit!)
*.cer
*.p12
*.csr
developerID_application.cer
sqlpage.key
sqlpage.p12
sqlpage_cert.pem

# Nix build result and direnv cache
/result
.direnv/
