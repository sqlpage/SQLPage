{
  "name": "sqlpage",
  "version": "1.0.0",
  "scripts": {
    "build": "node scripts/build-frontend.mjs",
    "build:rust": "npm ci --ignore-scripts && npm run build && cargo build",
    "test": "biome check . && npm run typecheck && node --test \"tests/js/**/*.spec.ts\"",
    "typecheck": "tsc && tsc -p tests/js && tsc -p tests/end-to-end",
    "format": "biome format --write .",
    "fix": "biome check --fix --unsafe .",
    "site": "npm run build && cd examples/official-site && cargo run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sqlpage/SQLPage.git"
  },
  "license": "MIT",
  "dependencies": {
    "@tabler/core": "1.7.4",
    "@tabler/icons-sprite": "3.51.0",
    "apexcharts": "8.8.1",
    "tom-select": "2.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "rolldown": "^1.3.1",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "tests/end-to-end"
  ]
}
