{
  "name": "sqlpage",
  "version": "1.0.0",
  "scripts": {
    "build": "node scripts/build-frontend.mjs",
    "build:rust": "npm ci --ignore-scripts && npm run build && cargo build",
    "test": "biome check . && npm run typecheck && node --test \"tests/js/**/*.spec.ts\"",
    "typecheck": "tsc && tsc -p tests/js && tsc -p tests/end-to-end",
    "format": "biome format --write .",
    "fix": "biome check --fix --unsafe .",
    "site:build": "node scripts/site-build.mjs",
    "site": "npm run build && npm run site:build && cd target/official-site && cargo run --locked --manifest-path ../../Cargo.toml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sqlpage/SQLPage.git"
  },
  "license": "MIT",
  "dependencies": {
    "@tabler/core": "1.7.5",
    "@tabler/icons-sprite": "3.53.0",
    "apexcharts": "8.9.1",
    "tom-select": "2.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/leaflet": "^1.9.23",
    "@types/node": "^26.6.10",
    "rolldown": "^1.3.3",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "tests/end-to-end"
  ]
}
