<div {{#if id}} id="{{id}}"{{/if}} class="badges-list my-2 flex-wrap {{#if center}} justify-content-center{{/if}} {{class}}">
{{#each_row}}
{{#delay}}
{{#if ../size}}badge-{{../size}}{{/if}}{{#if color}}{{#if (not ../light)}} bg-{{color}} text-{{color}}-fg{{else}} bg-{{color}}-lt text-{{color}}-lt-fg{{/if}}{{/if}}{{#if ../outline}} badge-outline{{/if}}{{#if ../pill}} badge-pill{{/if}}
{{/delay}}
{{~#if link~}}
    <a href="{{link}}" class="badge {{flush_delayed}}">{{title}}</a>
{{~else~}}
    <span class="badge {{flush_delayed}}">{{title}}</span>
{{~/if~}}
{{/each_row}}
</div>
