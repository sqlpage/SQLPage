<section class="docs-links" id="{{id}}" aria-labelledby="{{id}}-heading">
    <h2 id="{{id}}-heading"><a class="docs-self-link" href="#{{id}}">{{title}}</a></h2>
    <div class="docs-link-grid">
        {{#each_row}}
            <div class="docs-link-card">
                <h3>
                    <a href="{{link}}">{{#if icon}}{{icon_img icon 24}}{{/if}}{{title}}</a>
                </h3>
                <p>{{description}}</p>
                {{#if links}}
                    <ul>
                        {{#each (to_array links)}}<li><a href="{{link}}"><code>{{title}}</code></a></li>{{/each}}
                    </ul>
                {{/if}}
            </div>
        {{/each_row}}
    </div>
</section>
