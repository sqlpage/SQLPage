{{!-- For a live preview, send end_result after the last native component. --}}
{{#if end_result}}
            </div>
        </div>
    </div>
</section>
{{else}}
<section class="docs-example mt-5 pt-4 border-top" id="example-{{number}}">
    <h3><a class="docs-self-link" href="#example-{{number}}">{{#if title}}{{title}}{{else}}Example {{number}}{{/if}}</a></h3>
    {{#if description_md}}<div class="remove-bottom-margin">{{{markdown description_md}}}</div>{{/if}}
    {{#if preview}}<div class="docs-example-layout mt-3 border rounded">{{/if}}
    {{#if source}}
        <div class="docs-example-source{{#unless preview}} mt-3 border rounded{{/unless}}">
            <div class="docs-code-toolbar">
                <span>{{icon_img "file-code" 18}} index.sql</span>
                <button type="button" class="btn btn-sm ms-auto d-print-none" hidden>{{icon_img "copy" 16}} <span aria-live="polite">Copy SQL</span></button>
            </div>
            <pre class="mb-0 rounded-0 bg-transparent" tabindex="0" aria-label="Example {{number}} SQL"><code class="language-sql">{{source}}</code></pre>
        </div>
    {{/if}}
    {{#if preview}}
        <div class="docs-example-result bg-surface">
            <h4 class="docs-code-toolbar">{{icon_img "player-play" 16}} Result</h4>
            <div class="docs-example-output">
    {{else}}
</section>
    {{/if}}
{{/if}}
