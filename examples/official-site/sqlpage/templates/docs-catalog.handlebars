<header id="overview" class="card card-body">
    <div class="row align-items-center g-4">
        <div class="col-md">
            <a href="/documentation.sql">{{icon_img "arrow-left" 16}} Documentation</a>
            <h1 class="docs-title">{{#if (eq kind "component")}}Components{{else}}Functions{{/if}}</h1>
            <p class="lead text-secondary mb-0">
                {{#if (eq kind "component")}}
                    Choose what your SQL renders. Explore the parameters and live examples for each component.
                {{else}}
                    Call <code>sqlpage.*</code> to read requests, work with files, and reach external services. Brackets mark optional arguments.
                {{/if}}
            </p>
        </div>
        <div class="col-md">
            {{#if picks}}
                <nav class="row row-cols-3 g-2" aria-label="Featured components">
                    {{#each (to_array picks)}}
                        <div class="col">
                            <a class="card card-link align-items-center gap-2 p-3 font-monospace" href="{{link}}">
                                <span class="text-primary" aria-hidden="true">{{icon_img icon 32}}</span>
                                {{name}}
                            </a>
                        </div>
                    {{/each}}
                </nav>
            {{else}}
                <figure class="card m-0">
                    <figcaption class="card-header py-2 justify-content-between">
                        <span>{{icon_img "code" 16}} SQL</span>
                        <a href="/functions.sql?function=url_encode">View function {{icon_img "arrow-right" 14}}</a>
                    </figcaption>
                    <div class="card-body">
                        <code><span class="hljs-keyword">select</span> sqlpage.url_encode(<wbr><span class="hljs-string">'hello world'</span>);</code>
                        <div class="text-secondary mt-2">Result <samp>{{encoded_example}}</samp></div>
                    </div>
                </figure>
            {{/if}}
        </div>
    </div>
</header>

<div id="catalog" class="docs-columns mt-4">
    <details open class="docs-disclosure">
        <summary class="subheader">
            Categories
            {{#if category_title}}<span class="catalog-selection">{{category_title}}</span>{{/if}}
            {{icon_img "chevron-down" 15}}
        </summary>
        <nav class="nav nav-vertical" aria-label="Categories">
            <a class="nav-link" href="{{all_link}}" {{#unless category}}aria-current="page"{{/unless}}>
                All {{plural}} <small class="ms-auto" aria-hidden="true">{{all_count}}</small>
            </a>
            {{#each (to_array categories)}}
                <a class="nav-link" href="{{link}}" {{#if (eq id ../category)}}aria-current="page"{{/if}}>
                    {{title}} <small class="ms-auto" aria-hidden="true">{{count}}</small>
                </a>
            {{/each}}
        </nav>
        {{#if (eq kind "function")}}
            <a class="d-block mt-3 pt-2 border-top" href="#evaluation">{{icon_img "book-2" 16}} Function evaluation</a>
        {{/if}}
    </details>
    <div class="catalog-results">
        <div class="d-flex flex-wrap align-items-center gap-3">
            <form class="input-group input-group-flat" role="search" aria-label="Search {{plural}}" action="{{action}}#catalog" method="get">
                <span class="input-group-text" aria-hidden="true">{{icon_img "search" 19}}</span>
                <input class="form-control" type="search" name="q" value="{{query}}" aria-label="Search {{plural}}" placeholder="Name or purpose">
                {{#if category}}<input type="hidden" name="category" value="{{category}}">{{/if}}
                <button class="btn" type="submit">Search</button>
            </form>
            <small class="text-secondary">{{matched}} {{#if (eq matched 1)}}{{kind}}{{else}}{{plural}}{{/if}}</small>
            {{#if (and matched (or query category))}}<a href="{{clear_link}}">Clear filters</a>{{/if}}
        </div>
        {{#unless matched}}
            <div class="empty empty-bordered mt-4">
                <div class="empty-icon">{{icon_img "search-off"}}</div>
                <h2 class="empty-title">No matching {{plural}}</h2>
                <p class="empty-subtitle text-secondary">
                    {{#if (and category all_count)}}
                        <a href="{{all_link}}">See matches in other categories</a> or try another name.
                    {{else}}
                        Try another name or a broader search.
                    {{/if}}
                </p>
                <a class="empty-action" href="{{clear_link}}">Clear filters {{icon_img "arrow-right" 16}}</a>
            </div>
        {{/unless}}
        {{#each_row}}
            <section class="mt-4" aria-labelledby="group-{{id}}">
                <h2 id="group-{{id}}">{{title}}</h2>
                <ul class="list-unstyled {{#if (eq ../kind "component")}}docs-card-grid{{else}}list-group{{/if}}">
                    {{#each (to_array entries)}}
                        <li class="catalog-entry {{#if (eq ../../kind "component")}}card p-3{{else}}list-group-item list-group-item-action{{/if}}">
                            <span class="text-primary" aria-hidden="true">{{icon_img icon 20}}</span>
                            <h3 class="h3 font-monospace mb-0">
                                <a class="stretched-link text-reset" href="{{link}}" aria-labelledby="entry-{{name}}"
                                   aria-describedby="summary-{{name}}{{#if arguments}} args-{{name}}{{/if}}{{#if example_count}} count-{{name}}{{/if}}">
                                    <span id="entry-{{name}}">{{name}}</span>{{~#if (eq ../../kind "function")}}<span class="text-secondary fw-normal" id="args-{{name}}">(<wbr>{{arguments}})</span>{{/if}}
                                </a>
                            </h3>
                            <p class="text-secondary mb-0" id="summary-{{name}}">{{summary}}</p>
                            {{#if example_count}}
                                <small class="text-secondary" id="count-{{name}}">
                                    {{icon_img "code" 14}} {{example_count}} {{#if (eq example_count 1)}}example{{else}}examples{{/if}}
                                </small>
                            {{/if}}
                            <span class="text-secondary" aria-hidden="true">{{icon_img "arrow-right" 16}}</span>
                        </li>
                    {{/each}}
                </ul>
            </section>
        {{/each_row}}
    </div>
</div>
