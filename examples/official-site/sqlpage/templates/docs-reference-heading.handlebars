<header id="{{id}}" class="border-bottom pb-4 mb-4">
    <a href="{{link}}">{{icon_img icon 18}} {{section}}</a>
    <h1 class="docs-title my-2">{{title}}</h1>
    <div class="d-flex flex-wrap gap-3 small">
        {{#if version}}<span class="text-secondary">Since SQLPage {{version}}</span>{{/if}}
        {{#if return_type}}<span class="text-secondary">Returns <code>{{return_type}}</code></span>{{/if}}
        {{#if jump_link}}<a href="{{jump_link}}">{{jump_text}}</a>{{/if}}
    </div>
</header>
